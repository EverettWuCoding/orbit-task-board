# Supabase project URL and PUBLIC publishable (or legacy anon) key only.
# NEVER use a service_role key or an sb_secret_ key in a frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Both values empty: explicitly labeled local demo. A partially configured
# project shows a setup error instead of silently falling back to local storage.